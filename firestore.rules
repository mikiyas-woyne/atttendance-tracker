rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidStudent(data) {
      return data.keys().hasAll(['studentId', 'fullName', 'age', 'status']) &&
             data.studentId is string && data.studentId.size() >= 3 && data.studentId.size() <= 30 &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             data.age is number && data.age >= 1 && data.age <= 120 &&
             data.status in ['active', 'inactive'];
    }

    // Default catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Admin records
    match /admins/{adminUid} {
      allow read, write: if true;
    }

    // Student records: Public create, read & list for cross-device sync & student status lookup
    match /students/{studentDocId} {
      allow create: if isValidStudent(request.resource.data) && request.resource.data.status == 'active';
      allow read, get, list, update, delete: if true;
    }

    // Attendance sessions: Read/Write across devices
    match /attendanceSessions/{sessionDocId} {
      allow read, get, list, create, update, delete: if true;
    }

    // Attendance records: Read/Write for cross-device sync & student status check
    match /attendanceRecords/{recordDocId} {
      allow read, get, list, create, update, delete: if true;
    }

    // Absence alerts: Admin notification management
    match /absenceAlerts/{alertDocId} {
      allow read, get, list, create, update, delete: if true;
    }
  }
}
